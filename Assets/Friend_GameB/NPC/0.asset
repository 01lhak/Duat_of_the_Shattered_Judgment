  npcName: "\uBA54\uC81C\uB4DC"
  age: "\uC2E0\uBE44\uC5D0 \uC2F8\uC778 \uBD88\uBA78\uC758 \uC874\uC7AC"
  gender: "\uC18C\uB144\uC758 \uBAA8\uC2B5\uC744 \uD55C \uC601\uC801\uC778 \uC2E0"
  job: "\uC0AC\uD6C4\uC138\uACC4\uC758 \uC740\uBC00\uD55C \uCC98\uC18C"
  affiliation: "\uC2E0\uB4E4\uC774 \uBD88\uB7EC\uB0B8 \uD2B9\uBCC4 \uC870\uC0AC\uAD00 "
  description: "\uBA54\uC81C\uB4DC(Mejed) - \uCC98\uBC8C\uC790\n\n\uC0AC\uD6C4\uC138\uACC4\uC5D0\uC11C
    \uBE44\uBC00\uB9AC\uC5D0 \uD65C\uB3D9\uD558\uB294 \uC2E0.\n\n\uB2E4\uB978 \uC2E0\uB4E4\uACFC
    \uB2EC\uB9AC \uD6C4\uB4DC\uAC00 \uB2EC\uB9B0 \uC18C\uBC15\uD558\uACE0 \uC21C\uBC31\uC758
    \uC608\uBCF5\uC744 \uC785\uC740 \uC18C\uB144\uC758 \uC678\uD615\uC744 \uD558\uACE0
    \uC788\uB2E4.\n\uAC00\uC2B4\uC5D0 \uC0C8\uACA8\uC9C4 \uBD89\uC740 \uC559\uD06C
    \uBB38\uC591\uACFC \uD6C4\uB4DC \uC0AC\uC774\uB85C \uB4DC\uB7EC\uB09C \uCC28\uBD84\uD55C
    \uB208\uBE5B\uC740 \uADF8\uAC00 \uD3C9\uBC94\uD55C \uC874\uC7AC\uAC00 \uC544\uB2D8\uC744
    \uC99D\uBA85\uD55C\uB2E4.\n\n\uC0AC\uD6C4\uC138\uACC4\uC758 \uC9C8\uC11C\uB97C
    \uB4A4\uD754\uB4DC\uB294 \uC0AC\uAC74\uC744 \uD574\uACB0\uD558\uAE30 \uC704\uD574
    \uC2E0\uB4E4\uC5D0\uAC8C \uC18C\uD658\uB418\uC5B4 '\uC2EC\uD310'\uC774\uC790
    '\uC870\uC0AC\uAD00' \uC5ED\uD560\uC744 \uB9E1\uAC8C \uB418\uC5C8\uB2E4."
  commentPortrait: {fileID: 3221518058522072045, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  comment: "\uC21C\uC218\uD55C \uC18C\uB144\uC758 \uC5BC\uAD74 \uB4A4\uC5D0 \uBB34\uC5C7\uC744
    \uC228\uAE30\uACE0 \uC788\uB294\uC9C0\u2026\n\uB124\uAC00 \uAC00\uC838\uC62C
    \uC99D\uAC70\uB97C \uBCF4\uACE0 \uD310\uB2E8\uD558\uACA0\uC5B4."
