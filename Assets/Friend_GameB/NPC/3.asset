  icon: {fileID: -840731485814971197, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  npcName: "\uC138\uD2B8"
  age: "\uC0AC\uB9C9\uACFC \uD3ED\uD48D, \uD63C\uB3C8\uC758 \uC9C0\uBC30\uC790"
  gender: "\uBD89\uC740 \uD138\uC744 \uAC00\uC9C4 \uB291\uB300 \uC218\uC778 \uD615\uC0C1"
  job: "\uBD89\uC740 \uC0AC\uB9C9\uC758 \uAC70\uCC98"
  affiliation: "\uC9C4\uC2E4\uC758 \uC6A9\uC758\uC790 \uC120\uC0C1 \uC911 \uD55C
    \uBA85"
  description: "\uC138\uD2B8(Seth) - \uD63C\uB3C8\uC758 \uC2E0\n\n\uBD89\uC740 \uC0AC\uB9C9\uC758
    \uAC70\uCE5C \uD3ED\uD48D\uC744 \uBD80\uB9AC\uB294 \uAC15\uC778\uD558\uACE0 \uB09C\uD3ED\uD55C
    \uC2E0.\n\n\uC778\uAC04\uC758 \uBAB8\uC5D0 \uD749\uD3EC\uD55C \uBD89\uC740 \uB291\uB300\uC758
    \uBA38\uB9AC\uB97C \uD55C \uC678\uD615\uC744 \uC9C0\uB154\uC73C\uBA70, \uAC00\uC2B4\uD30D\uC758
    \uAC70\uB300\uD55C \uBD89\uC740 \uBCF4\uC11D\uACFC \uB2E8\uB2E8\uD55C \uCCB4\uAD6C\uC5D0\uC11C
    \uD30C\uAD34\uC801\uC778 \uD798\uC774 \uBFDC\uC5B4\uC838 \uB098\uC628\uB2E4.\n\n\uC774\uBC88
    \uC0AC\uD6C4\uC138\uACC4\uC758 \uC774\uBCC0\uC744 \uADF8\uC800 \uD765\uBBF8\uB85C\uC6B4
    \uC18C\uB3D9 \uC815\uB3C4\uB85C \uC0DD\uAC01\uD558\uACE0 \uC788\uC9C0\uB9CC,
    \uB204\uAD70\uAC00 \uC7A5\uB09C\uC73C\uB85C\uB77C\uB3C4 \uC790\uC2E0\uC744 \uBC94\uC778
    \uCDE8\uAE09\uD558\uBA74 \uB2F9\uC7A5\uC774\uB77C\uB3C4 \uB0A0\uCE74\uB85C\uC6B4
    \uC774\uBE68\uC744 \uB4DC\uB7EC\uB0B8\uB2E4."
  commentPortrait: {fileID: -956463854301356735, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  comment: "\uC5B4\uB77C? \uC774\uBC88 \uC18C\uB3D9, \uC660\uC9C0 \uC800 \uBB34\uC2DD\uD558\uAC8C
    \uD798\uB9CC \uC13C \uBD89\uC740 \uC57C\uC218\uAC00 \uC2EC\uC2EC\uD574\uC11C
    \uBC8C\uC778 \uC9D3 \uAC19\uC740\uB370? \uC544\uB2C8\uBA74 \uB9D0\uACE0!"
