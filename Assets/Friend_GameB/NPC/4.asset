  npcID: 4
  portrait: {fileID: 2896269194891937230, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  icon: {fileID: -956463854301356735, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  npcName: "\uD638\uB8E8\uC2A4"
  age: "\uD558\uB298\uACFC \uD0DC\uC591\uC758 \uC9C0\uBC30\uC790"
  gender: "\uD478\uB978 \uAE43\uD138\uACFC \uAC80\uC740 \uD53C\uBD80\uC758 \uC804\uC0AC"
  job: "\uCC9C\uC0C1\uC758 \uC2E0\uC804"
  affiliation: "\uBA54\uC81C\uB4DC\uC758 \uB4F1\uC7A5\uC744 \uBC18\uAE30\uB294 \uC2E0\uB4E4
    \uC911 \uD55C \uBA85"
  description: "\uD638\uB8E8\uC2A4(Horus) - \uD0DC\uC591\uC758 \uC2E0\n\n\uC9C0\uC0C1\uC758
    \uD30C\uB77C\uC624\uB4E4\uC744 \uC218\uD638\uD558\uB294 \uC815\uC758\uB85C\uC6B4
    \uD0DC\uC591\uC758 \uC2E0.\n\n\uB2E4\uBD80\uC9C4 \uCCB4\uACA9\uACFC \uC5B4\uB450\uC6B4
    \uD53C\uBD80, \uADF8\uB9AC\uACE0 \uC5B4\uAE68\uC640 \uB4F1 \uB4A4\uB85C \uD769\uB0A0\uB9AC\uB294
    \uC2E0\uBE44\uB85C\uC6B4 \uD478\uB978\uC0C9 \uAE43\uD138 \uC7A5\uC2DD\uC774 \uD2B9\uC9D5\uC774\uB2E4.
    \uAE08\uBE5B \uB208\uB3D9\uC790\uB85C \uC0C1\uB300\uB97C \uB0A0\uCE74\uB86D\uAC8C
    \uB178\uB824\uBCF4\uBA70 \uD314\uC9F1\uC744 \uB07C\uACE0 \uC788\uB294 \uBAA8\uC2B5\uC5D0\uC11C
    \uD0C0\uD611 \uC5C6\uB294 \uAC15\uC778\uD568\uC774 \uB290\uAEF4\uC9C4\uB2E4.\n\n\uC774\uBC88
    \uC18C\uB3D9\uC744 \uD558\uB098\uC758 \uC720\uCF8C\uD55C \uCD95\uC81C\uCC98\uB7FC
    \uC990\uAE30\uBA70 \uC5EC\uC720\uB9CC\uB9CC\uD55C \uD0DC\uB3C4\uB97C \uC720\uC9C0\uD558\uACE0
    \uC788\uB2E4."
  commentPortrait: {fileID: -840731485814971197, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  comment: "\uC0C8\uB300\uAC00\uB9AC \uB140\uC11D, \uC99D\uAC70\uB3C4 \uC5C6\uC73C\uBA74\uC11C
    \uB0B4\uAC00 \uBC94\uC778\uC774\uAE38 \uC740\uADFC\uD788 \uBC14\uB77C\uB294 \uB208\uCE58\uAD70.
    \uAC78\uB9AC\uAE30\uB9CC \uD574\uBD10\uB77C, \uD655 \uD138\uC744 \uBF51\uC544\uBC84\uB9B4
    \uD14C\uB2C8."
