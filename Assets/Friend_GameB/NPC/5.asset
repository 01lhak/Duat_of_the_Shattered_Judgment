  npcName: "\uC624\uC2DC\uB9AC\uC2A4"
  age: "\uC0AC\uD6C4\uC138\uACC4\uB97C \uB2E4\uC2A4\uB9AC\uB294 \uBA85\uACC4\uC758
    \uC655"
  gender: "\uB192\uC740 \uC655\uAD00\uC744 \uC4F4 \uC790\uBE44\uB85C\uC6B4 \uAD70\uC8FC"
  job: "\uB450\uC544\uD2B8\uC758 \uC911\uC2EC \uAD81\uC804"
  affiliation: "\uC774\uBC88 \uC774\uBCC0\uC744 \uC9C0\uCF1C\uBCF4\uB294 \uAD00\uCC30\uC790"
  description: "\uC624\uC2DC\uB9AC\uC2A4(Osiris) - \uBA85\uACC4\uC758 \uC655\n\n\uC0AC\uD6C4\uC138\uACC4\uC758
    \uCD5C\uACE0 \uC9C0\uBC30\uC790\uC774\uC790 \uC800\uC2B9\uC758 \uC655.\n\n\uC655\uAD8C\uC744
    \uC0C1\uC9D5\uD558\uB294 \uB192\uACE0 \uD654\uB824\uD55C \uC774\uC9D1\uD2B8 \uC804\uD1B5
    \uC655\uAD00(\uC544\uD14C\uD504)\uC744 \uC4F0\uACE0 \uC788\uC73C\uBA70, \uD770\uC0C9\uACFC
    \uD669\uAE08\uBE5B\uC774 \uC218\uB193\uC544\uC9C4 \uC758\uBCF5\uC744 \uC785\uACE0
    \uC591\uC190\uC744 \uB113\uAC8C \uBC8C\uB824 \uC911\uC0DD\uC744 \uAD6C\uC81C\uD558\uB824\uB294
    \uC790\uBE44\uB85C\uC6B4 \uBAA8\uC2B5\uC744 \uD558\uACE0 \uC788\uB2E4.\n\n\uC0AC\uD6C4\uC138\uACC4\uC5D0
    \uC77C\uC5B4\uB09C \uC804\uB300\uBBF8\uBB38\uC758 \uC774\uBCC0 \uC18D\uC5D0\uC11C\uB3C4
    \uAD70\uC8FC \uD2B9\uC720\uC758 \uAE30\uD488 \uC788\uB294 \uBBF8\uC18C\uC640
    \uC2E0\uC131\uD55C \uC5EC\uC720\uB97C \uC783\uC9C0 \uC54A\uB294 (\uCC99\uD55C)\uB2E4."
  commentPortrait: {fileID: 4979876616108224910, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  comment: "\uC655\uAED8\uC11C \uB610 \uC591\uC190\uC744 \uBC8C\uB9B0 \uCC44 \uB10B\uC744
    \uB193\uACE0 \uACC4\uC2DC\uB294\uAD70. \uACB0\uC7AC \uB3C4\uC7A5\uC774\uB098
    \uBE68\uB9AC \uCC0D\uC5B4\uC8FC\uC168\uC73C\uBA74 \uC88B\uACA0\uB294\uB370 \uB9D0\uC774\uB2E4."
