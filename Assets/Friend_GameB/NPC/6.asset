  icon: {fileID: 3221518058522072045, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  npcName: "\uB9C8\uC544\uD2B8"
  age: "\uC6B0\uC8FC\uC758 \uC9C8\uC11C\uC640 \uC9C4\uB9AC\uC758 \uC218\uD638\uC790"
  gender: "\uBA38\uB9AC\uC5D0 \uD0C0\uC870 \uAE43\uD138\uC744 \uC7A5\uC2DD\uD55C
    \uC5EC\uC2E0"
  job: "\uC2EC\uD310\uC758 \uBC95\uC815 \uC911\uC559 \uC800\uC6B8"
  affiliation: "\uD310\uACB0\uC744 \uB0B4\uB9AC\uB294 \uC808\uB300\uC801 \uAE30\uC900"
  description: "\uB9C8\uC544\uD2B8(Maat) - \uC815\uC758\uC758 \uC5EC\uC2E0\n\n\uC6B0\uC8FC\uC758
    \uB3C4\uB355\uC801 \uC9C8\uC11C\uC640 \uC815\uC758\uB97C \uC0C1\uC9D5\uD558\uB294
    \uC5EC\uC2E0.\n\n\uAC74\uAC15\uD558\uAC8C \uBE5B\uB098\uB294 \uAD6C\uB9BF\uBE5B
    \uD53C\uBD80\uC640 \uAE38\uAC8C \uB5CF\uBAA9\uCC98\uB7FC \uB54B\uC544 \uB0B4\uB9B0
    \uD751\uBC1C, \uADF8\uB9AC\uACE0 \uD770\uC0C9\uACFC \uD669\uAE08\uC774 \uC870\uD654\uB97C
    \uC774\uB8EC \uD654\uB824\uD55C \uB4DC\uB808\uC2A4\uB97C \uC785\uC740 \uB9E4\uD639\uC801\uC778
    \uC678\uD615\uC774\uB2E4. \uBA38\uB9AC \uC7A5\uC2DD \uC911\uC559\uC5D0 \uAF42\uD78C
    \uD0C0\uC870 \uAE43\uD138\uC740 \uB9DD\uC790\uC758 \uC8C4\uB97C \uBB34\uAC8C\uB85C
    \uC7AC\uB294 \uC808\uB300\uC801\uC778 \uAE30\uC900\uC810\uC774\uB2E4.\n\n\uC6B0\uC544\uD558\uAC8C
    \uC190\uC744 \uB0B4\uBC00\uBA70 \uC790\uBE44\uB85C\uC6B4 \uBBF8\uC18C\uB97C \uC9D3\uACE0
    \uC788\uC9C0\uB9CC, \uD310\uACB0 \uC55E\uC5D0\uC11C\uB294 \uCCA0\uC800\uD558\uAC8C
    \uC911\uB9BD\uC744 \uC9C0\uD0A8\uB2E4."
  commentPortrait: {fileID: 4994189535252466317, guid: 3380b02fe2432fa47a6b4e801e9521d1, type: 3}
  comment: "\uC544\uB984\uB2E4\uC6B4 \uC5EC\uC2E0\uC774\uC9C0\uB9CC \uC800 \uD0C0\uC870
    \uAE43\uD138\uB85C \uBB34\uAC8C\uB97C \uC7AC\uB294 \uBC95\uC815\uC740 \uC5B8\uC81C
    \uBD10\uB3C4 \uBB34\uC12D\uB2E4\uB0E5. \uAC70\uC9D3\uB9D0\uC744 \uD588\uB2E4\uAC04
    \uC601\uD63C\uC774 \uB0A0\uC544\uAC08 \uAC70\uB2E4\uB0E5!"
