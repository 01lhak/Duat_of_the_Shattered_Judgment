  m_Script: {fileID: 11500000, guid: a42c71f6a512ace4899b7cf387b81388, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  dialogues:
  - "\uD558\uD558\uD558! \uBA54\uC81C\uB4DC, \uB124\uAC00 \uADF8 \uC720\uBA85\uD55C
    \uBE44\uBC00 \uC870\uC0AC\uAD00\uC774\uB0D0?"
  - "\uC0C8\uB300\uAC00\uB9AC \uB140\uC11D\uC774 \uC544\uAE4C\uBD80\uD130 \uB0A0
    \uD790\uB054\uAC70\uB9AC\uBA74\uC11C \uBC94\uC778 \uCDE8\uAE09\uC744 \uD558\uB358\uB370, "
  - "\uB09C \uADF8\uB0E5 \uC774 \uC0C1\uD669\uC774 \uC6C3\uAE30\uACE0 \uC7AC\uBBF8\uC788\uC744
    \uBFD0\uC774\uB77C\uACE0."
  - "\uD558\uC9C0\uB9CC \uC7A5\uB09C\uC73C\uB85C\uB77C\uB3C4 \uB0A0 \uBC94\uC778\uC73C\uB85C
    \uD655\uC815 \uC9C0\uC5B4\uC11C \uBAB0\uC544\uC138\uC6B0\uC9C4 \uB9C8\uB77C."
  - "\uC2E0\uB4E4\uC758 \uC5EC\uC720\uACE0 \uBB50\uACE0, \uADF8 \uB0A0\uCE74\uB85C\uC6B4
    \uB208\uC744 \uD655 \uBF51\uC544\uBC84\uB9B4 \uD14C\uB2C8\uAE4C!"
  - "\uC790, \uC5B4\uB514 \uD55C\uBC88 \uC81C\uB300\uB85C \uD30C\uD5E4\uCCD0 \uBCF4\uC2DC\uC9C0!"
  icon: {fileID: 0}
  npcStandingSprite: {fileID: 0}
  targetSceneName: 
  cancelDialogues: []
