  lines:
  - characterIndex: 0
    characterSprite: {fileID: 8827819776277483811, guid: 15950a1c0fbce024fb0eeba5f62528e1, type: 3}
    text: ...
    choices: []
    nextLine: -1
  - characterIndex: 2
    characterSprite: {fileID: -1880530801529709714, guid: 49298d90f9157764a90d470a011956d4, type: 3}
    text: "\uC900\uBE44\uB294 \uB05D\uB0AC\uB294\uAC00, \uBA54\uC81C\uB4DC."
    choices: []
    nextLine: -1
  - characterIndex: 2
    characterSprite: {fileID: -1670052083742655148, guid: b83b801c6c73f5241a51d16c1def31dc, type: 3}
    text: "\uC774\uACF3\uC5D0 \uD769\uC5B4\uC9C4 \uC9C4\uC2E4\uC758 \uC870\uAC01\uB4E4\uC744
      \uB9C8\uC8FC\uD560 \uAC01\uC624\uAC00 \uB418\uC5C8\uB290\uB0D0\uB294 \uB9D0\uC774\uB2E4.\r\n"
    choices:
    - choiceText: "\uBB3C\uB860\uC774\uC9C0."
      jumpToLine: 3
    - choiceText: "\uC544\uC9C1\uC774\uC57C."
      jumpToLine: 4
    nextLine: -1
  - characterIndex: 2
    characterSprite: {fileID: -7158718261441972789, guid: b83b801c6c73f5241a51d16c1def31dc, type: 3}
    text: "\uC88B\uB2E4. \uADF8 \uBD88\uAD74\uC758 \uB208\uBE5B\uC774 \uAC70\uC9D3\uC744
      \uAFF0\uB6AB\uC5B4 \uBCF4\uAE30\uB97C \uBC14\uB77C\uC9C0."
    choices: []
    nextLine: 6
  - characterIndex: 2
    characterSprite: {fileID: 6424908659233299714, guid: 78cd0053d17fcc149b6e61e393bf7718, type: 3}
    text: "\uB9DD\uC124\uC784\uC740 \uB2F9\uC5F0\uD558\uB2E4."
    choices: []
    nextLine: -1
  - characterIndex: 2
    characterSprite: {fileID: 5131450735319528384, guid: b83b801c6c73f5241a51d16c1def31dc, type: 3}
    text: "\uD558\uC9C0\uB9CC \uC2DC\uAC04\uC740 \uC8FD\uC740 \uC790\uC758 \uD3B8\uC774
      \uC544\uB2C8\uB2C8, \uC11C\uB458\uB7EC\uC57C \uD560 \uAC83\uC774\uB2E4."
    choices: []
    nextLine: -1
  - characterIndex: 0
    characterSprite: {fileID: 5714941976916137246, guid: 7a43f60e7e3b9b047aeee597935ccbe8, type: 3}
    text: "<i>...\uC228\uACA8\uC9C4 \uC9C4\uC2E4\uC740 \uC5B8\uC81C\uB098 \uCC28\uAC00\uC6B4
      \uBC95\uC774\uB2E4.</i>"
    choices: []
    nextLine: -1
  - characterIndex: 0
    characterSprite: {fileID: 5714941976916137246, guid: 7a43f60e7e3b9b047aeee597935ccbe8, type: 3}
    text: "<i>\uC124\uB839 \uADF8\uAC83\uC774 \uC2E0\uC758 \uC774\uB984\uC744 \uB354\uB7FD\uD788\uB294
      \uBE44\uADF9\uC77C\uC9C0\uB77C\uB3C4,</i>"
    choices: []
    nextLine: -1
  - characterIndex: 0
    characterSprite: {fileID: -2065456308188949842, guid: 15950a1c0fbce024fb0eeba5f62528e1, type: 3}
    text: "<i>...\uB09C \uBA48\uCD94\uC9C0 \uC54A\uC544.</i>"
    choices: []
    nextLine: -1
  - characterIndex: 2
    characterSprite: {fileID: -1670052083742655148, guid: b83b801c6c73f5241a51d16c1def31dc, type: 3}
    text: "\uC0AC\uC18C\uD55C \uD754\uC801 \uD558\uB098\uB3C4 \uB193\uCE58\uC9C0
      \uB9C8\uB77C."
    choices: []
    nextLine: -1
  - characterIndex: 2
    characterSprite: {fileID: -1880530801529709714, guid: 49298d90f9157764a90d470a011956d4, type: 3}
    text: "\uB124\uAC00 \uCC3E\uC544\uB0B8 \uB2E8\uC11C\uB9CC\uC774 \uB2EB\uD78C
      \uC774\uB4E4\uC758 \uC785\uC744 \uC5F4 \uC218 \uC788\uC744 \uD14C\uB2C8\uAE4C."
    choices: []
    nextLine: -1
  - characterIndex: 2
    characterSprite: {fileID: -7158718261441972789, guid: b83b801c6c73f5241a51d16c1def31dc, type: 3}
    text: "\uC790, \uAC00\uB77C."
    choices: []
    nextLine: -1
