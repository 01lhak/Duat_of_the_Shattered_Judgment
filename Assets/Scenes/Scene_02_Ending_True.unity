  - {fileID: 21300000, guid: 4b7b239bf99ed504dac1ed4308e0b34e, type: 3}
  - {fileID: 21300000, guid: 46e16879f1325e9488eb3001b05250e8, type: 3}
  - {fileID: 21300000, guid: 46e16879f1325e9488eb3001b05250e8, type: 3}
  - {fileID: 21300000, guid: 4b7b239bf99ed504dac1ed4308e0b34e, type: 3}
  - {fileID: 21300000, guid: 4b7b239bf99ed504dac1ed4308e0b34e, type: 3}
  - {fileID: 21300000, guid: 4b7b239bf99ed504dac1ed4308e0b34e, type: 3}
  dialogues:
  - "\uC9C4\uC2E4\uC758 \uC5EC\uC2E0 \uB9C8\uC544\uD2B8. \uC544\uB204\uBE44\uC2A4\uC5D0\uAC8C
    \uB4E4\uC5C8\uC5B4."
  - "\uB2F9\uC2E0\uC774 \uC0AC\uD6C4\uC138\uACC4\uC758 \uC2EC\uD310 \uAE30\uB85D\uC744
    \uC804\uBA74 \uC870\uC791\uD588\uB2E4\uB294 \uAC8C \uC0AC\uC2E4\uC774\uC57C?"
  - "......\uCC98\uBC8C\uC790 \uBA54\uC81C\uB4DC\uC5EC, \uC99D\uAC70\uB3C4 \uC5C6\uC774
    \uAC10\uD788 \uC2E0\uC758 \uD310\uACB0\uC744 \uBAA8\uB3C5\uD558\uB294\uAC00?"
  - "<i>\uC870\uC791\uB41C \uBA85\uBD80 \uC870\uAC01\uC744 \uAEBC\uB0B4\uB4E0\uB2E4.</i>"
  - "\uC774\uAC8C \uBC14\uB85C \uADF8 \uC99D\uAC70\uC57C."
  - "\uB9C8\uC544\uD2B8 \uC5EC\uC2E0\uC758 \uC778\uC7A5\uC774 \uCC0D\uD78C \uC704\uC870\uB41C
    \uC601\uD63C\uB4E4\uC758 \uBA85\uBD80!"
  - "\uD750\uC74C..."
  - "\uADF8\uAC78 \uAE30\uC5B4\uCF54 \uCC3E\uC544\uB0C8\uAD6C\uB098."
  - "\uADF8\uB798, \uB0B4\uAC00 \uC870\uC791\uD588\uB2E4."
  - "\uC774\uB300\uB85C \uB450\uBA74 \uBAA8\uB4E0 \uC778\uAC04\uC758 \uC601\uD63C\uC774
    \uC8C4\uC778\uC73C\uB85C \uD310\uC815\uB418\uC5B4 \uC18C\uBA78\uD560 \uD14C\uB2C8\uAE4C."
  - "\uB098\uB294 \uADF8\uB4E4\uC744 \uAD6C\uD558\uAE30 \uC704\uD574 \uC790\uBE44\uB85C\uC6B4
    \uAC70\uC9D3\uC744 \uC120\uD0DD\uD588\uC744 \uBFD0\uC774\uB2E4."
  - "\uC790\uBE44\uB85C\uC6B4 \uAC70\uC9D3\uC774\uB77C\uB2C8..."
  - "\uADF8\uB807\uB2E4\uBA74 \uB2F9\uC2E0\uC740 \uC5B4\uB5A4 \uD310\uACB0\uC744
    \uB0B4\uB9B4 \uC148\uC774\uC9C0?"
  characterNames:
  - "\uBA54\uC81C\uB4DC"
  - "\uBA54\uC81C\uB4DC"
