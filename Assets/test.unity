  - {fileID: 21300000, guid: 14af8207b320cb54bbd8fdfbe69dbfde, type: 3}
  - {fileID: 21300000, guid: 0b5ec89c7d206a842b1e5a5568571594, type: 3}
  - {fileID: 21300000, guid: 0b5ec89c7d206a842b1e5a5568571594, type: 3}
  - {fileID: 21300000, guid: 0b5ec89c7d206a842b1e5a5568571594, type: 3}
  - {fileID: 21300000, guid: 4c4339b6d9e2721499bd685b0c7f1232, type: 3}
  - {fileID: 21300000, guid: 5a825d956e03a404f955bef93505a432, type: 3}
  - {fileID: 21300000, guid: 5a825d956e03a404f955bef93505a432, type: 3}
  - {fileID: 21300000, guid: 5a825d956e03a404f955bef93505a432, type: 3}
  - {fileID: 21300000, guid: 0b5ec89c7d206a842b1e5a5568571594, type: 3}
  dialogues:
  - "...\uC6B0\uC120 \uC870\uC0AC\uB294 \uC774\uC815\uB3C4\uBA74 \uCDA9\uBD84\uD560
    \uAC83 \uAC19\uC544."
  - "\uB2E4\uC74C\uC73C\uB85C \uD560 \uC77C\uC740..."
  - "\uC0AC\uAC74\uC758 \uC21C\uC11C\uC5D0 \uB9DE\uAC8C \uC99D\uAC70\uB97C \uB098\uC5F4\uD574\uC57C\uACA0\uB124."
  - "\uC5B4\uB824\uC6B4 \uAC74 \uC544\uB2C8\uC9C0\uB9CC, \uBA38\uB9AC\uB97C \uB9DE\uB300\uBA74
    \uB354 \uC218\uC6D4\uD574\uC9C8\uAC70\uC57C."
  - "\uADF8 \uC815\uB3C4\uC57C \uC2DD\uC740 \uC8FD \uBA39\uAE30\uC9C0."
  - "\uC774\uB9AC \uB0B4. \uC774 \uBAB8\uC774 \uC804\uBD80 \uD574\uACB0\uD574 \uC904
    \uD14C\uB2C8\uAE4C."
  - "...\uB108 \uADF8 \uC9DC\uC99D\uB098\uB294 \uD3EC\uC988 \uC880 \uADF8\uB9CC\uD558\uBA74
    \uC548 \uB3FC?"
  - "\uBCFC\uB54C\uB9C8\uB2E4 \uC18D\uC774 \uBA54\uC2A4\uAEBC\uC6CC\uC9C4\uB2E4\uACE0."
  - "\uD765, \uB124 \uB188\uC774 \uB208\uC744 \uAC10\uC73C\uBA74 \uB420 \uC77C\uC774\uB2E4."
  - "\uC774 \uBAB8\uC758 \uC2DC\uADF8\uB2C8\uCC98 \uD3EC\uC988\uB97C \uBB34\uC2DC\uD558\uB294\uAC70\uB0D0?"
  - "\uC73C\uD734, \uC9C4\uC9DC..."
  - "\uB124 \uB9D0\uC774 \uB9DE\uC544. \uC5BC\uB978 \uC99D\uAC70\uB098 \uC815\uB9AC\uD558\uC790."
  - "\uD558\uD558! \uC774\uC81C\uC11C\uC57C \uC774 \uBAB8\uC758 \uC704\uB300\uD568\uC744
    \uC778\uC815\uD558\uB294\uAD70!"
  characterNames:
  - "\uBA54\uC81C\uB4DC"
  - "\uBA54\uC81C\uB4DC"
  - "\uBA54\uC81C\uB4DC"
  - "\uBA54\uC81C\uB4DC"
  - "\uC544\uB204\uBE44\uC2A4"
